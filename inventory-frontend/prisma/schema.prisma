model PantryItems {
  id             Int    @id @default(autoincrement())
  ahId           Int
  name           String
  description    String
  purchaseDate   DateString
  expirationDate DateString
}

model Pantry {
  id                    Int    @id @default(autoincrement())
  ahId                  Int
  name                  String
  description           String
  amount                Int
  expirationDateLowest  DateString
  expirationDateHighest DateString
  purchaseDateLowest    DateString
  purchaseDateHighest   DateString
}

model AlbertHeijnItems {
  id            Int    @id @default(autoincrement())
  ahId          Int
  name          String
  description   String
  shelfLifeDays Int
}

